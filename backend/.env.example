# IndTube Backend — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# PostgreSQL (your own self-controlled database)
DATABASE_URL=postgresql://user:password@localhost:5432/indtube

# S3-compatible storage (your own self-controlled bucket)
STORAGE_ENDPOINT=https://s3.example.com
STORAGE_BUCKET=indtube-media
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=https://cdn.example.com

# Auth — JWT
JWT_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
